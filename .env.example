# PASTI admin CMS (/admin) — copy to .env and fill in. Never commit .env.

# CMS database (Postgres). Supabase: project → Connect → Connection string →
# URI → Transaction pooler (port 6543), with your database password filled
# in. Set → all CMS data lives in the database (table cms.kv; create it with
# `npm run cms:db-migrate`, copy local data with `npm run cms:db-import`).
# Unset → local files in .data/cms (development only; production refuses).
NUXT_CMS_DATABASE_URL=
# Recommended: the database provider's root CA certificate (PEM; Supabase:
# Database → Settings → SSL Configuration → Download certificate). Set → the
# server certificate is verified. Unset → encrypted, but not verified.
# In .env: ONE line, wrapped in double quotes, line breaks written as \n:
#   NUXT_CMS_DATABASE_CA="-----BEGIN CERTIFICATE-----\nMIID…\n-----END CERTIFICATE-----"
# (unquoted, the value is cut at the first \n). On Vercel paste the PEM as is.
NUXT_CMS_DATABASE_CA=
# Escape hatch for a production-like local preview without a database.
# Never true on serverless hosting (its disk is not persistent).
NUXT_CMS_ALLOW_FS_STORAGE=false

# Required. HMAC key for session-token hashing; >= 32 random chars.
# Production refuses to serve the CMS without it.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NUXT_CMS_SESSION_SECRET=

# Set to true only behind a trusted proxy (Vercel, nginx) so X-Forwarded-For
# / X-Forwarded-Host are used for rate limiting and the same-origin check.
NUXT_CMS_TRUST_PROXY=false

# --- Dev-only seed ---------------------------------------------------------
# On first start with an empty .data/cms store, `npm run dev` creates:
#   admin@pastipeople.local   (ADMIN)
#   editor@pastipeople.local  (EDITOR)
# with the passwords below (min 12 chars). Re-seed: delete .data/cms.
# Outside `nuxt dev` the seed only runs when NUXT_CMS_ALLOW_SEED=true.
NUXT_CMS_SEED_ADMIN_PASSWORD=
NUXT_CMS_SEED_EDITOR_PASSWORD=
NUXT_CMS_ALLOW_SEED=false

# --- Public About ← CMS (Step 3) -------------------------------------------
# false (default): /about renders its existing code content, exactly as
#   before; /api/public/pages/about answers { status: "disabled" }.
# true: /about maps the PUBLISHED CMS snapshot onto the existing About
#   components (supported fields only), falling back to code content on any
#   failure. Server-only flag — not readable or overridable by the browser.
# The CMS still holds DUMMY content: real About content must be migrated
# before this is turned on anywhere public. Dummy seed content is refused
# outside `nuxt dev` even when true.
NUXT_CMS_ABOUT_PUBLIC_ENABLED=false
# Company-proof numbers (Venn stats) stay code-managed unless this is also
# true. Keep false until real, approved figures are in the CMS.
NUXT_CMS_ABOUT_PUBLIC_PROOF_ENABLED=false

# --- Public Technology ← CMS ------------------------------------------------
# false (default): /technology renders its existing code content (useTechnology)
#   exactly as before; /api/public/pages/technology answers { status: "disabled" }.
# true: /technology renders the PUBLISHED Technology CMS snapshot through the
#   normalized adapter (useTechnologyPage), falling back to code content on any
#   failure. Server-only flag — not readable or overridable by the browser
#   (no query, cookie or header switch). Dummy seed content is refused outside
#   `nuxt dev` even when true.
NUXT_CMS_TECHNOLOGY_PUBLIC_ENABLED=false

# --- Public Creative ← CMS --------------------------------------------------
# false (default): /creative renders its existing code content (useCreative)
#   exactly as before; /api/public/pages/creative answers { status: "disabled" }.
# true: /creative renders the PUBLISHED Creative CMS snapshot through the
#   normalized adapter (useCreativePage), falling back to code content on any
#   failure. Server-only flag — not readable or overridable by the browser.
#   Dummy seed content is refused outside `nuxt dev` even when true.
NUXT_CMS_CREATIVE_PUBLIC_ENABLED=false

# --- Public Work ← CMS ------------------------------------------------------
# false (default): /work renders its existing code content (useWorkPortfolio +
#   useFeaturedCases) exactly as before; /api/public/work answers
#   { status: "disabled" }.
# true: /work renders the PUBLISHED Work page joined with PUBLISHED projects
#   and case studies (confirmed claims / images only) through the normalized
#   adapter (useWorkPage), falling back to code content on any failure.
#   Server-only flag — no query, cookie or header switch. Dummy seed content
#   is refused outside `nuxt dev` even when true. The homepage never reads it.
NUXT_CMS_WORK_PUBLIC_ENABLED=false

# --- Public Insights ← CMS ---------------------------------------------------
# false (default): /insights renders its existing code content (useInsights)
#   exactly as before; /api/public/insights answers { status: "disabled" }.
# true: /insights renders the PUBLISHED Insights landing joined with PUBLISHED
#   articles and PUBLISHED + active categories through the normalized adapter
#   (useInsightsPage), falling back to code content on any failure.
#   Server-only flag — no query, cookie or header switch. Dummy seed content is
#   refused outside `nuxt dev` even when true. The homepage Insights section
#   keeps its code content and never reads this.
NUXT_CMS_INSIGHTS_PUBLIC_ENABLED=false

# --- Public Contact ← CMS ----------------------------------------------------
# false (default): /contact renders its existing code wording (useContact +
#   the Contact components) exactly as before; /api/public/pages/contact
#   answers { status: "disabled" }.
# true: /contact renders the PUBLISHED Contact CMS wording (hero, channel
#   labels, form copy, SEO) through the normalized adapter (useContactPage),
#   falling back to code wording on any failure. Server-only flag — no query,
#   cookie or header switch. Dummy seed content is refused outside `nuxt dev`
#   even when true. Shared contact data (WhatsApp number, email, address,
#   socials) and all form behaviour stay in code either way.
NUXT_CMS_CONTACT_PUBLIC_ENABLED=false

# --- Media library (Supabase Storage) ----------------------------------------
# Image uploads from the admin go to a PUBLIC Supabase Storage bucket. Unset →
# uploads answer 503 and image fields still accept /images/ paths.
#   NUXT_CMS_SUPABASE_URL          https://<project-ref>.supabase.co
#   NUXT_CMS_SUPABASE_SERVICE_KEY  service_role (or sb_secret_) key — SERVER
#                                  ONLY, never expose it to the browser
#   NUXT_CMS_MEDIA_BUCKET          bucket name (default cms-media)
# Create the bucket once with: npm run cms:media-setup
NUXT_CMS_SUPABASE_URL=
NUXT_CMS_SUPABASE_SERVICE_KEY=
NUXT_CMS_MEDIA_BUCKET=cms-media

# --- Public OPEN product page --------------------------------------------------
# false (default): /open renders its code copy (useOpen) unchanged.
# true: /open renders the PUBLISHED OPEN CMS copy (useOpenPage), falling back
#   to the code copy on any failure. Server-only flag. Ids, tab wiring,
#   illustration mock-ups and the demo form stay in code either way.
NUXT_CMS_OPEN_PUBLIC_ENABLED=false

# --- Public SHIFTLY / e-CORPORATE product pages -------------------------------
# Same behaviour as OPEN: false (default) = code copy; true = published CMS
# copy with a code fallback. Server-only flags.
NUXT_CMS_SHIFTLY_PUBLIC_ENABLED=false
NUXT_CMS_ECORPORATE_PUBLIC_ENABLED=false

# --- Public FAST / DORA / MATRIX product pages ---------------------------------
# Same behaviour as OPEN: false (default) = code copy; true = published CMS
# copy with a code fallback. Server-only flags.
NUXT_CMS_FAST_PUBLIC_ENABLED=false
NUXT_CMS_DORA_PUBLIC_ENABLED=false
NUXT_CMS_MATRIX_PUBLIC_ENABLED=false

# --- Shared Content: Clients / FAQs / Global CTAs -----------------------------
# false (default) = code content (useClients, useFaq, useFinalCta/useFooter).
# true = the PUBLISHED Shared Content copy, falling back to code on any
# failure. Clients: homepage marquee + About grid. FAQs: homepage FAQ.
# Global CTAs: footer closing band + shared contact facts (footer, /contact).
# The WhatsApp number and legal entity name stay in code either way.
NUXT_CMS_CLIENTS_PUBLIC_ENABLED=false
NUXT_CMS_FAQS_PUBLIC_ENABLED=false
NUXT_CMS_CTAS_PUBLIC_ENABLED=false

# --- Public Testimonials (shared collection) ----------------------------------
# false (default): GET /api/public/testimonials answers { status: "disabled" }.
# true: it returns public-eligible testimonials only — published + active +
#   publication approval `confirmed` for the published wording — with an
#   optional ?ids=a,b (max 20). Server-only flag. No page reads this yet: Home
#   and every other page keep their current testimonial source until a page
#   integration step switches them. Dev seed records are never served outside
#   `nuxt dev`.
NUXT_CMS_TESTIMONIALS_PUBLIC_ENABLED=false
